{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "dockerfile",
    "gomod",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update leases cleanup job image digest in Helm values",
      "managerFilePatterns": [
        "/^helm-charts/policy-controller-operator/values\\.yaml$/"
      ],
      "matchStrings": [
        "leasescleanup:\\s*\\n[\\s\\S]*?repository:\\s*(?<depName>[^\\s]+)@sha256\\s*\\n[ \\t]+version:\\s*(?<currentValue>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "constraintsFiltering": "strict",
  "gomod": {
    "packageRules": [
      {
        "description": "Do not bump the go directive - must stay at current version to prevent cascading dep upgrades",
        "matchPackageNames": [
          "go"
        ],
        "enabled": false
      },
      {
        "description": "Allow MintMaker to update indirect Go dependencies",
        "matchDepTypes": [
          "indirect"
        ],
        "enabled": true
      },
      {
        "description": "Sigstore dependency updates must be performed manually",
        "matchPackageNames": [
          "/^github\\.com\\/sigstore\\//"
        ],
        "enabled": false
      },
      {
        "description": "Group all Go module updates together",
        "matchPackageNames": [
          "*"
        ],
        "groupName": "Go Dependencies",
        "groupSlug": "go-deps"
      }
    ]
  },
  "packageRules": [
    {
      "description": "Group all Docker image updates together",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Docker Images",
      "groupSlug": "docker-deps"
    }
  ]
}
