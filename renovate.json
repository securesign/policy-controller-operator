{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "ignorePresets": [
    "config:recommended",
    "group:recommended",
    "group:monorepo"
  ],
  "enabledManagers": [
    "dockerfile",
    "gomod",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update leases cleanup job image digest in Helm values",
      "managerFilePatterns": [
        "/^helm-charts/policy-controller-operator/values\\.yaml$/"
      ],
      "matchStrings": [
        "leasescleanup:\\s*\\n[\\s\\S]*?repository:\\s*(?<depName>[^\\s]+)@sha256\\s*\\n[ \\t]+version:\\s*(?<currentValue>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": [
        "Group all Go module updates together"
      ],
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go Dependencies",
      "groupSlug": "go-deps"
    },
    {
      "description": [
        "Group all Docker image updates together"
      ],
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Docker Images",
      "groupSlug": "docker-deps"
    }
  ],
  "gomod": {
    "postUpdateOptions": [
      "gomodTidy"
    ],
    "packageRules": [
      {
        "description": [
          "Allow MintMaker to update indirect Go dependencies"
        ],
        "matchManagers": [
          "gomod"
        ],
        "matchDepTypes": [
          "indirect"
        ],
        "enabled": true
      },
      {
        "description": [
          "Go version upgrades must be performed manually"
        ],
        "matchDepTypes": [
          "golang",
          "toolchain"
        ],
        "allowedVersions": "<=1.26.0",
        "enabled": false
      },
      {
        "description": [
          "Reject dependencies that require a newer Go version"
        ],
        "matchManagers": [
          "gomod"
        ],
        "constraintsFiltering": "strict"
      },
      {
        "description": [
          "Sigstore dependency updates must be performed manually"
        ],
        "matchPackageNames": [
          "/^github\\.com\\/sigstore\\//"
        ],
        "enabled": false
      }
    ]
  }
}
